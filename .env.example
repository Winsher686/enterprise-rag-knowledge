# ===== LLM =====
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen3-32b

# ===== Embedding =====
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ===== Vector Store =====
VECTOR_STORE=chroma
MILVUS_HOST=milvus
MILVUS_PORT=19530
CHROMA_PERSIST_DIR=./data/chroma

# ===== MongoDB =====
MONGO_URI=mongodb://mongo:27017
MONGO_DB=enterprise_rag

# ===== MinIO =====
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=rag-images

# ===== App =====
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
